{
  "name": "data-quality-card-v3",
  "version": "3.0.0",
  "description": "HubSpot UI Extension — Data Quality Card V3 avec CrmPropertyList natif et score de complétude",
  "private": true,
  "scripts": {
    "start": "hs project dev",
    "build": "hs project upload",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix"
  },
  "dependencies": {
    "@hubspot/ui-extensions": "^0.12.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@hubspot/ui-extensions$": "<rootDir>/src/__mocks__/@hubspot/ui-extensions.js",
      "^@hubspot/ui-extensions/crm$": "<rootDir>/src/__mocks__/@hubspot/ui-extensions/crm.js"
    },
    "coverageThreshold": {
      "global": {
        "lines": 70,
        "branches": 65,
        "functions": 70
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/__mocks__/**",
      "!src/**/__tests__/**"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
